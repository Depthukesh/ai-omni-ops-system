# OpenChatCut 受控 fork 的源码根目录，必须指向 package.json 所在目录。
# 不要在每台电脑上手工修改官方源码；后续如需补丁，应统一沉淀到 fork / 受控镜像。
OPENCHATCUT_SOURCE_DIR=../OpenChatCut
OPENCHATCUT_HTTP_PORT=15199
OPENCHATCUT_HOME_DIR=./local-data/openchatcut/home
OPENCHATCUT_MEDIA_DIR=./local-data/openchatcut/media
OPENCHATCUT_MCP_TOKEN=change-me
# Docker 端口发布场景下，允许 localhost/127.0.0.1 浏览器请求绕过容器内 socket 非 loopback 的限制。
OPENCHATCUT_TRUST_DOCKER_LOCALHOST=1
# 如果 OpenChatCut 跑在 Docker，但主系统跑在宿主机，OpenChatCut 页面里的 API URL 不要再填 127.0.0.1:13011。
# 这对容器来说是“容器自己”。应改填宿主机地址，例如 http://host.docker.internal:13011/api/openclaw/openchatcut-gateway
# 建议与浏览器真实访问地址保持一致，避免一边访问 localhost 一边写成 127.0.0.1。
OPENCHATCUT_EDITOR_URL=http://localhost:15199
RESOURCE_PREVIEW_TOKEN=change-me
