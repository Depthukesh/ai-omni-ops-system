POSTGRES_DB=ai_omni_ops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
HOST_POSTGRES_PORT=15432

APP_PORT=3011
WEB_PORT=3001
HOST_API_PORT=13011
HOST_WEB_PORT=13001
HOST_MIXEDCUT_PORT=15000
HOST_MIXEDCUT_MCP_PORT=15501

# Default compose startup now focuses on postgres + server + web.
# Add --profile mixedcut (and optionally --profile mixedcut-mcp) when you need mixedcut containers too.

SERVER_HOST=0.0.0.0
WEB_HOST=0.0.0.0

WEB_PUBLIC_BASE_URL=http://127.0.0.1:13001
NEXT_PUBLIC_WEB_BASE_URL=http://127.0.0.1:13001
API_PUBLIC_BASE_URL=http://127.0.0.1:13011/api
WEB_API_BASE_URL=http://127.0.0.1:13011
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:13011/api
INTERNAL_API_BASE_URL=http://server:3011/api
API_PROXY_TARGET=http://server:3011/api
NEXT_PUBLIC_MIXEDCUT_BASE_URL=http://127.0.0.1:15000
MIXEDCUT_INTERNAL_BASE_URL=http://mixedcut:5000

STORAGE_PROVIDER_MODE=local

# Container paths used by the server container.
MATERIAL_LIBRARY_BASE_ROOT=/data/materials
MANAGED_STORAGE_ROOT=/data/storage
MIXEDCUT_INSTALL_ROOT=/data/mixedcut

# Host paths shown back to the user in pages and OpenClaw results.
MATERIAL_LIBRARY_DISPLAY_ROOT=D:\AiOmniOpsData\materials
MANAGED_STORAGE_DISPLAY_ROOT=D:\AiOmniOpsData\storage

# Host bind roots used by docker compose.
AI_OMNI_HOST_DATA_ROOT=./local-data
AI_OMNI_HOST_POSTGRES_ROOT=./local-data/postgres
AI_OMNI_HOST_MIXEDCUT_ROOT=./local-data/mixedcut
AI_OMNI_HOST_MATERIALS_ROOT=./local-data/materials
AI_OMNI_HOST_STORAGE_ROOT=./local-data/storage
AI_OMNI_HOST_LOGS_ROOT=./local-data/logs

JWT_SECRET=
JWT_REFRESH_SECRET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
