generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipLevel {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SystemRole {
  USER
  SUPER_ADMIN
  ADMIN_OPERATOR
  FINANCE_OPERATOR
  SUPPORT_OPERATOR
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum TaskStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum PlatformType {
  XIAOHONGSHU
  DOUYIN
  VIDEO_CHANNEL
  WECHAT_OA
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  HTML
  ARCHIVE
}

enum BrandMemberRole {
  OWNER
  ADMIN
  EDITOR
  OPERATOR
  VIEWER
}

enum BrandMemberStatus {
  ACTIVE
  INVITED
  DISABLED
  REMOVED
}

enum BrandInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AssetCategory {
  INDUSTRY_REPORT
  BUSINESS_DATA
  PLATFORM_EXPORT
  GENERATED_REPORT
  GENERATED_CONTENT
  KNOWLEDGE_FILE
}

model User {
  id             String             @id @default(cuid())
  mobile         String             @unique
  email          String?            @unique
  emailVerifiedAt DateTime?
  nickname       String?
  avatarUrl      String?
  passwordHash   String
  status         UserStatus         @default(ACTIVE)
  membership     MembershipLevel    @default(FREE)
  systemRole     SystemRole         @default(USER)
  pointsBalance  Int                @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  brands         Brand[]            @relation("BrandOwner")
  brandMemberships BrandMember[]
  sentBrandInvites BrandInvite[]    @relation("BrandInviter")
  receivedBrandInvites BrandInvite[] @relation("BrandInvitee")
  brandInviteReadStates BrandInviteReadState[]
  brandInviteNotifications BrandInviteNotification[]
  brandRoleAuditOperations BrandRoleAuditLog[] @relation("BrandRoleAuditOperator")
  brandRoleAuditTargets BrandRoleAuditLog[] @relation("BrandRoleAuditTargetUser")
  sessions       UserSession[]
  emailVerificationCodes EmailVerificationCode[]
  usedRegistrationInviteCodes RegistrationInviteCode[] @relation("RegistrationInviteCodeConsumer")
  tasks          Task[]
  mediaAssets    MediaAsset[]
  orders         MembershipOrder[]
  pointLedgers   PointLedger[]
  feishuIntegration UserFeishuIntegration?
  skillProfiles  UserSkillProfile[]
  promptOverrides UserPromptOverride[]
  skillResetLogs UserSkillResetLog[]
  thirdPartyPlatformSecrets UserThirdPartyPlatformSecret[]
}

model EmailVerificationCode {
  id          String   @id @default(cuid())
  userId      String?
  email       String
  purpose     String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

model RegistrationInviteCode {
  id               String   @id @default(cuid())
  code             String   @unique
  consumedByUserId String?
  consumedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  consumedByUser   User?    @relation("RegistrationInviteCodeConsumer", fields: [consumedByUserId], references: [id], onDelete: SetNull)

  @@index([consumedAt, createdAt])
  @@index([consumedByUserId])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  currentBrandId   String?
  deviceInfo       String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentBrand     Brand?    @relation(fields: [currentBrandId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model MembershipOrder {
  id            String          @id @default(cuid())
  userId        String
  orderNo       String          @unique
  orderType     String
  orderStatus   OrderStatus     @default(PENDING)
  membership    MembershipLevel?
  pointsAmount  Int?
  amountYuan    Decimal         @db.Decimal(10, 2)
  metaJson      Json?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PointLedger {
  id            String          @id @default(cuid())
  userId        String
  changeType    String
  pointsDelta   Int
  balanceAfter  Int
  description   String?
  relatedTaskId String?
  createdAt     DateTime        @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Brand {
  id                 String              @id @default(cuid())
  ownerUserId        String
  brandName          String
  industry           String?
  storeCount         Int?
  foundedYear        Int?
  brandDescription   String?
  enterpriseIntro    String?
  memberPermissionsJson Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  owner              User                @relation("BrandOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members            BrandMember[]
  invites            BrandInvite[]
  inviteNotifications BrandInviteNotification[]
  roleAuditLogs      BrandRoleAuditLog[]
  currentSessions    UserSession[]
  products           Product[]
  surveys            BrandSurvey[]
  platformAccounts   PlatformAccount[]
  competitorAccounts CompetitorAccount[]
  industryReports    IndustryReport[]
  businessAssets     BusinessAsset[]
  tasks              Task[]
  mediaAssets        MediaAsset[]
  userSkillProfiles  UserSkillProfile[]
  userPromptOverrides UserPromptOverride[]
  userSkillResetLogs UserSkillResetLog[]
  brandSkillProfiles BrandSkillProfile[]
  brandPromptOverrides BrandPromptOverride[]
  brandSkillResetLogs BrandSkillResetLog[]
  thirdPartyPlatformSecrets UserThirdPartyPlatformSecret[]
  brandThirdPartyPlatformSecrets BrandThirdPartyPlatformSecret[]

  @@index([ownerUserId, createdAt])
}

model BrandMember {
  id              String            @id @default(cuid())
  brandId         String
  userId          String
  role            BrandMemberRole   @default(OWNER)
  status          BrandMemberStatus @default(ACTIVE)
  joinedAt        DateTime          @default(now())
  invitedByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  brand           Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([brandId, userId])
  @@index([userId, status])
  @@index([brandId, role])
}

model BrandInvite {
  id              String            @id @default(cuid())
  brandId         String
  inviteeUserId   String?
  inviteAccount   String
  inviteCode      String            @unique
  role            BrandMemberRole   @default(EDITOR)
  status          BrandInviteStatus @default(PENDING)
  note            String?
  invitedByUserId String
  expiresAt       DateTime?
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  brand           Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  inviteeUser     User?             @relation("BrandInvitee", fields: [inviteeUserId], references: [id], onDelete: SetNull)
  invitedByUser   User              @relation("BrandInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  notifications   BrandInviteNotification[]
  readStates      BrandInviteReadState[]
  roleAuditLogs   BrandRoleAuditLog[]

  @@index([brandId, status, createdAt])
  @@index([inviteeUserId, status])
  @@index([invitedByUserId, createdAt])
}

model BrandInviteNotification {
  id        String      @id @default(cuid())
  inviteId   String
  userId     String
  brandId    String
  title      String
  summary    String
  actionUrl  String?
  readAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  invite     BrandInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
  @@index([userId, readAt, createdAt])
  @@index([brandId, updatedAt])
}

model BrandInviteReadState {
  id        String      @id @default(cuid())
  inviteId  String
  userId    String
  readAt    DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  invite     BrandInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
  @@index([userId, readAt])
  @@index([inviteId, readAt])
}

model BrandRoleAuditLog {
  id             String      @id @default(cuid())
  brandId        String
  operatorUserId String
  targetUserId   String?
  targetInviteId String?
  action         String
  summary        String
  detailJson     Json?
  createdAt      DateTime    @default(now())

  brand          Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  operatorUser   User        @relation("BrandRoleAuditOperator", fields: [operatorUserId], references: [id], onDelete: Cascade)
  targetUser     User?       @relation("BrandRoleAuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetInvite   BrandInvite? @relation(fields: [targetInviteId], references: [id], onDelete: SetNull)

  @@index([brandId, createdAt])
  @@index([operatorUserId, createdAt])
  @@index([targetUserId, createdAt])
}

model Product {
  id                   String    @id @default(cuid())
  brandId              String
  productName          String
  productType          String?
  price                Decimal?  @db.Decimal(10, 2)
  productPositioning   String?
  targetAudience       String?
  painPoint            String?
  usageScenario        String?
  differentiators      String?
  marketPosition       String?
  detailDescription    String?
  imageUrl             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  brand                Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
}

model BrandSurvey {
  id                  String    @id @default(cuid())
  brandId             String
  surveyType          String
  surveyJson          Json
  summary             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  brand               Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, surveyType])
}

model PlatformAccount {
  id                  String       @id @default(cuid())
  brandId             String
  platform            PlatformType
  accountName         String?
  accountLink         String
  username            String?
  isPrimary           Boolean      @default(true)
  lastCollectedAt     DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  brand               Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, platform])
}

model WechatAccountConfig {
  brandId             String   @id
  appId               String
  appSecret           String
  whitelistIpsJson    Json
  defaultAuthor       String?
  defaultThemeColor   String?
  commentMode         String
  updatedAt           DateTime @updatedAt

  @@index([updatedAt])
}

model WechatWorkflowPreference {
  brandId             String   @id
  defaultAuthor       String
  defaultThemeColor   String
  commentMode         String
  fanCommentsOnly     Boolean  @default(false)
  defaultInputType    String
  defaultAccountId    String?
  updatedAt           DateTime @updatedAt

  @@index([updatedAt])
}

model WechatOfficialAccount {
  id                  String   @id
  brandId             String
  accountName         String
  appId               String
  appSecret           String
  whitelistIpsJson    Json
  isDefault           Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@index([brandId, updatedAt])
  @@index([brandId, isDefault])
}

model WechatWorkflowSession {
  id                        String   @id
  brandId                   String
  accountId                 String?
  accountName               String?
  status                    String
  currentStep               String
  inputType                 String
  inputContent              String?
  title                     String
  summary                   String
  author                    String
  content                   String
  htmlContent               String
  articleProvider           String?
  articleRuntimeKey         String?
  articleModelName          String?
  coverImageBrief           String?
  bodyImageBriefsJson       Json?
  themeColor                String
  commentMode               String
  imageMode                 String
  injectBrandProfile        Boolean  @default(false)
  selectedMarketingLabelsJson Json
  selectedProductLabelsJson Json
  selectedBrandLabelsJson   Json
  imageBundleJson           Json?
  publishConfigJson         Json?
  linkedDraftId             String?
  errorDetail               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([brandId, updatedAt])
  @@index([brandId, status, updatedAt])
}

model WechatArticleDraft {
  id                        String   @id
  taskId                    String
  brandId                   String
  title                     String
  summary                   String
  author                    String
  content                   String
  htmlContent               String
  outputFormat              String
  coverMode                 String
  commentMode               String
  imageMode                 String
  themeColor                String
  injectMarketingCalendar   Boolean  @default(true)
  injectProducts            Boolean  @default(true)
  injectBrandProfile        Boolean  @default(false)
  selectedMarketingLabelsJson Json
  selectedProductLabelsJson Json
  selectedBrandLabelsJson   Json
  articleSkillSlug          String
  articlePromptScene        String
  articleProvider           String
  articleRuntimeKey         String
  articleModelName          String
  coverImageBrief           String?
  bodyImageBriefsJson       Json?
  imageTasksJson            Json?
  publishStatus             String
  publishedAt               DateTime?
  publishTaskId             String?
  taskStatus                String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([brandId, updatedAt])
  @@index([brandId, publishStatus, updatedAt])
  @@index([taskId])
}

model WechatPublishHistory {
  id                  String   @id
  brandId             String
  workflowId          String
  workflowTitle       String
  accountId           String?
  accountName         String?
  status              String
  summary             String
  coverImageUrl       String?
  mediaId             String?
  publishTaskId       String?
  sourceDraftId       String?
  commentMode         String
  fanCommentsOnly     Boolean  @default(false)
  retryCount          Int      @default(0)
  errorDetail         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([brandId, updatedAt])
  @@index([brandId, workflowId, updatedAt])
  @@index([publishTaskId])
}

model CompetitorAccount {
  id                  String       @id @default(cuid())
  brandId             String
  platform            PlatformType
  accountName         String?
  accountLink         String
  username            String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  brand               Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, platform])
}

model IndustryReport {
  id                  String       @id @default(cuid())
  brandId             String
  title               String
  summary             String?
  fileUrl             String?
  sourceName          String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  brand               Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
}

model BusinessAsset {
  id                  String         @id @default(cuid())
  brandId             String
  category            AssetCategory
  title               String
  description         String?
  fileUrl             String?
  metadataJson        Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  brand               Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, category, createdAt])
}

model Task {
  id                  String       @id @default(cuid())
  userId              String
  brandId             String?
  taskType            String
  taskStatus          TaskStatus   @default(PENDING)
  taskTitle           String?
  promptName          String?
  modelName           String?
  inputJson           Json?
  outputJson          Json?
  errorMessage        String?
  pointsCost          Int          @default(0)
  startedAt           DateTime?
  finishedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand               Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  mediaAssets         MediaAsset[]

  @@index([userId, createdAt])
  @@index([brandId, createdAt])
  @@index([taskStatus, createdAt])
}

model MediaAsset {
  id                  String       @id @default(cuid())
  userId              String
  brandId             String?
  taskId              String?
  mediaType           MediaType
  title               String
  sourceUrl           String?
  storageKey          String?
  mimeType            String?
  fileSize            Int?
  width               Int?
  height              Int?
  durationSec         Int?
  metadataJson        Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand               Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  task                Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([brandId, createdAt])
  @@index([taskId])
}

model UserFeishuIntegration {
  id                  String    @id @default(cuid())
  userId              String    @unique
  appId               String
  appSecret           String
  redirectUri         String
  scope               String
  providerUserOpenId  String?
  providerUserName    String?
  providerUserAvatar  String?
  accessToken         String?
  refreshToken        String?
  expiresAt           DateTime?
  refreshExpiresAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model SkillConfig {
  id           String   @id
  name         String
  slug         String   @unique
  category     String
  status       String
  provider     String
  defaultModel String
  pointsCost   Int      @default(0)
  description  String   @default("")
  updatedAt    DateTime @default(now())

  userSkillProfiles UserSkillProfile[]
  userPromptOverrides UserPromptOverride[]
  userSkillResetLogs UserSkillResetLog[]
  brandSkillProfiles BrandSkillProfile[]
  brandPromptOverrides BrandPromptOverride[]
  brandSkillResetLogs BrandSkillResetLog[]
}

model PromptTemplate {
  id          String   @id
  name        String
  scene       String
  version     String
  status      String
  modelName   String
  temperature Float    @default(0.7)
  maxTokens   Int      @default(4000)
  content     String   @default("")
  updatedAt   DateTime @default(now())

  userPromptOverrides UserPromptOverride[]
  brandPromptOverrides BrandPromptOverride[]

  @@index([scene, updatedAt(sort: Desc)])
}

model BrandSkillProfile {
  id           String   @id @default(cuid())
  brandId      String
  baseSkillId  String
  displayName  String?
  defaultModel String?
  description  String?
  lastResetAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brand        Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  baseSkill    SkillConfig @relation(fields: [baseSkillId], references: [id], onDelete: Cascade)

  @@unique([brandId, baseSkillId])
  @@index([baseSkillId, updatedAt])
}

model BrandPromptOverride {
  id           String   @id @default(cuid())
  brandId      String
  baseSkillId  String
  basePromptId String
  content      String?
  modelName    String?
  temperature  Float?
  maxTokens    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brand        Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  baseSkill    SkillConfig    @relation(fields: [baseSkillId], references: [id], onDelete: Cascade)
  basePrompt   PromptTemplate @relation(fields: [basePromptId], references: [id], onDelete: Cascade)

  @@unique([brandId, basePromptId])
  @@index([brandId, baseSkillId, updatedAt])
  @@index([basePromptId, updatedAt])
}

model BrandSkillResetLog {
  id           String   @id @default(cuid())
  brandId      String
  baseSkillId  String
  resetType    String
  promptIdsJson Json?
  createdAt    DateTime @default(now())

  brand        Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  baseSkill    SkillConfig @relation(fields: [baseSkillId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
  @@index([baseSkillId, createdAt])
}

model UserSkillProfile {
  id           String   @id @default(cuid())
  userId       String
  brandId      String?
  baseSkillId  String
  displayName  String?
  defaultModel String?
  description  String?
  lastResetAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand        Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  baseSkill    SkillConfig @relation(fields: [baseSkillId], references: [id], onDelete: Cascade)

  @@index([userId, brandId, updatedAt])
  @@index([baseSkillId, updatedAt])
}

model UserPromptOverride {
  id          String   @id @default(cuid())
  userId      String
  brandId     String?
  baseSkillId String
  basePromptId String
  content     String?
  modelName   String?
  temperature Float?
  maxTokens   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand       Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  baseSkill   SkillConfig  @relation(fields: [baseSkillId], references: [id], onDelete: Cascade)
  basePrompt  PromptTemplate @relation(fields: [basePromptId], references: [id], onDelete: Cascade)

  @@index([userId, brandId, baseSkillId, updatedAt])
  @@index([basePromptId, updatedAt])
}

model UserSkillResetLog {
  id           String   @id @default(cuid())
  userId       String
  brandId      String?
  baseSkillId  String
  resetType    String
  promptIdsJson Json?
  createdAt    DateTime @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand        Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  baseSkill    SkillConfig @relation(fields: [baseSkillId], references: [id], onDelete: Cascade)

  @@index([userId, brandId, createdAt])
  @@index([baseSkillId, createdAt])
}

model ApiProviderConfig {
  id                 String   @id
  name               String
  providerType       String
  status             String
  baseUrl            String
  tutorialUrl        String
  modelWhitelistJson Json
  apiKey             String
  defaultModel       String
  organization       String
  project            String
  timeoutMs          Int
  streamEnabled      Boolean
  customHeadersJson  Json
  extraParamsJson    Json
  remark             String
  successRate        Float
  requestCount24h    Int
  totalCostYuan      Float
  lastCalledAt       DateTime
  updatedAt          DateTime @updatedAt
}

model ThirdPartyPlatformConfig {
  id           String   @id
  name         String
  providerType String
  status       String
  baseUrl      String
  tutorialUrl  String
  modelIdsJson Json
  defaultModel String
  remark       String
  updatedAt    DateTime @updatedAt

  userSecrets  UserThirdPartyPlatformSecret[]
  brandSecrets BrandThirdPartyPlatformSecret[]
}

model UserThirdPartyPlatformSecret {
  id         String   @id
  userId     String
  brandId    String
  platformId String
  apiKey     String
  updatedAt  DateTime @updatedAt

  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand      Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform   ThirdPartyPlatformConfig @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId, platformId])
  @@index([brandId, platformId])
}

model BrandThirdPartyPlatformSecret {
  id         String   @id
  brandId    String
  platformId String
  apiKey     String
  updatedAt  DateTime @updatedAt

  brand      Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform   ThirdPartyPlatformConfig @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([brandId, platformId])
}

model DigitalHumanFavoriteTemplate {
  id         String   @id @default(cuid())
  userId     String
  brandId    String
  templateId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, brandId, templateId])
  @@index([brandId, updatedAt])
  @@map("digital_human_favorite_templates")
}

model DigitalHumanScriptTemplate {
  id        String   @id @default(cuid())
  userId    String
  brandId   String
  name      String
  content   String
  note      String   @default("")
  isShared  Boolean  @default(false)
  category  String   @default("general")
  isArchived Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, brandId, updatedAt])
  @@index([brandId, category, updatedAt])
  @@index([brandId, isArchived, updatedAt])
  @@index([brandId, isShared, updatedAt])
  @@index([brandId, updatedAt])
  @@map("digital_human_script_templates")
}
