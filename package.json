{
  "name": "ai-omni-ops-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:web:stable": "node scripts/dev-web-stable.cjs",
    "dev:web:stop": "node scripts/stop-web-stable.cjs",
    "dev:server": "npm --workspace apps/server run start:dev",
    "dev:server:stable": "node scripts/dev-server-stable.cjs",
    "dev:server:stop": "node scripts/stop-server-stable.cjs",
    "openclaw:mcp:server": "node scripts/openclaw-ai-omni-mcp-server.mjs",
    "smoke:openclaw:adapter": "node scripts/openclaw-mcp-adapter-smoke-test.mjs",
    "smoke:openclaw:mcp": "node scripts/openclaw-mcp-smoke-test.mjs",
    "build:web": "node scripts/run-web-next.cjs build",
    "build:server": "npm --workspace apps/server run build",
    "kimi:lab": "node scripts/kimi-lab.cjs",
    "lint:web": "node scripts/run-web-next.cjs lint",
    "lint:server": "npm --workspace apps/server run lint",
    "prisma:schema:local": "node scripts/generate-local-prisma-schema.cjs",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate:local": "node scripts/local-single-user-prisma.cjs generate",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:db:push:local": "node scripts/local-single-user-prisma.cjs db-push",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "image-prompts:import": "node scripts/import-image-prompt-center.cjs",
    "prisma:seed:registration-invite-codes": "node scripts/seed-registration-invite-codes.cjs",
    "prisma:seed": "node scripts/seed-demo.cjs",
    "db:init": "npm run prisma:generate && npm run prisma:db:push && npm run prisma:seed",
    "db:init:local": "node scripts/local-single-user-prisma.cjs db-init",
    "local:launcher": "node scripts/local-single-user-launcher.cjs",
    "local:release:build": "node scripts/build-local-single-user-release.cjs",
    "local:release:package": "node scripts/package-local-single-user-release.cjs",
    "local:release:upload:oss": "node scripts/upload-local-single-user-release-to-oss.cjs",
    "local:autostart:install": "node scripts/local-single-user-autostart.cjs install",
    "local:autostart:remove": "node scripts/local-single-user-autostart.cjs remove",
    "local:autostart:status": "node scripts/local-single-user-autostart.cjs status"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "15.5.15",
    "@prisma/client": "^6.16.1",
    "prisma": "^6.16.1"
  }
}
