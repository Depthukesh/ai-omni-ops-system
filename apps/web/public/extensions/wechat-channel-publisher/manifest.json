{
  "manifest_version": 3,
  "name": "AI全域运营 - 视频号辅助发布 PoC",
  "version": "0.1.3",
  "description": "用于验证视频号网页端是否可被浏览器扩展接管，包括页面注入、上传控件识别与表单填写能力。",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://17ai.site/*",
    "https://www.17ai.site/*",
    "https://channels.weixin.qq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://17ai.site/*",
        "https://www.17ai.site/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://channels.weixin.qq.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AI全域运营视频号辅助发布 PoC 0.1.3"
  }
}
